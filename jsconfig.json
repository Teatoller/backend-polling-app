// jsconfig.json (optional - for VS Code IntelliSense)
{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2020",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "checkJs": false,  // Don't check JavaScript files as TypeScript
    "allowJs": true   // Allow JavaScript files
    },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}